# ---------------------------------------------------------------------------
# JARVIS environment overrides.
# Every value here is optional: JARVIS ships with working defaults and stores
# its real configuration in ~/JARVIS/config/config.json.
# Environment variables always win over the config file.
# ---------------------------------------------------------------------------

# Server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Workspace (JARVIS' unrestricted working area)
JARVIS_WORKSPACE=~/JARVIS

# Local model runtime (default provider, no paid API required)
JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_FAST_MODEL=llama3.2:1b
JARVIS_GENERAL_MODEL=llama3.1:8b
JARVIS_VISION_MODEL=llava:7b

# Optional OpenAI-compatible provider (LM Studio, llama.cpp server, vLLM, OpenAI…)
# JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
# JARVIS_OPENAI_API_KEY=
# JARVIS_OPENAI_FAST_MODEL=gpt-4o-mini
# JARVIS_OPENAI_GENERAL_MODEL=gpt-4o

# Optional Anthropic-compatible provider
# JARVIS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# JARVIS_ANTHROPIC_API_KEY=
# JARVIS_ANTHROPIC_GENERAL_MODEL=claude-sonnet-4-5

# Voice
JARVIS_WAKE_WORD=jarvis
JARVIS_TTS_VOICE=Daniel
JARVIS_STT_MODEL=base.en

# Optional web search provider (DuckDuckGo HTML is used when unset — no key needed)
# JARVIS_BRAVE_API_KEY=
# JARVIS_SEARXNG_URL=http://127.0.0.1:8080

# Logging: DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO
