<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>JARVIS</string>
	<key>CFBundleDisplayName</key>
	<string>JARVIS</string>
	<key>CFBundleIdentifier</key>
	<string>local.jarvis.assistant</string>
	<key>CFBundleExecutable</key>
	<string>JARVIS</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>3.0</string>
	<key>CFBundleVersion</key>
	<string>3.0.dev10</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- The interface is served by JARVIS itself, on this Mac only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- JARVIS runs as this app's child process, so macOS asks on the app's
	     behalf: these are the reasons it shows. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>JARVIS listens for its wake word and for what you ask it, on this Mac.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>JARVIS controls apps like Mail, Calendar, Music and your browser when you ask it to.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>JARVIS turns what you say into text on this Mac.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>JARVIS reads and adds calendar events when you ask it to.</string>
	<key>NSRemindersUsageDescription</key>
	<string>JARVIS reads and adds reminders when you ask it to.</string>
	<key>NSContactsUsageDescription</key>
	<string>JARVIS looks up the people you mention.</string>
</dict>
</plist>
